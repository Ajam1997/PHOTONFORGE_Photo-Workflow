# PHOTONForge: Trigger rsync ingest when an SD card is inserted.
# Hardware: Yoga 920 right USB-A (usb-0:3), Genesys Logic GL3227E multi-slot reader (05e3:0749).
# Reader exposes two LUNs: LUN 0:0 (active card slot, sdb) and LUN 0:1 (empty, sdc).
# ENV{ID_FS_USAGE}=="filesystem" skips the empty LUN which has no filesystem.
# Hardware VID/PID/path matching is intentional — SD card labels are unpredictable.
# Install to /etc/udev/rules.d/ via scripts/install_udev.sh
#
# Ubuntu 24.04 note: ENV{DEVTYPE} is required — bare DEVTYPE is not reliable
# with systemd-udevd >= 252 on synthetic/replayed events.

ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", \
    ENV{ID_USB_DRIVER}=="usb-storage", \
    ENV{ID_VENDOR_ID}=="05e3", \
    ENV{ID_MODEL_ID}=="0749", \
    ENV{ID_PATH}=="*usb-0:3*", \
    ENV{ID_FS_USAGE}=="filesystem", \
    RUN+="/bin/sh -c 'echo \"[$(date -Iseconds)] [udev] SD add: /dev/%k label=%E{ID_FS_LABEL}\" >> /var/log/photonforge.log && /opt/photonforge/scripts/ingest_sd.sh /dev/%k >> /var/log/photonforge.log 2>&1'"

ACTION=="remove", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", \
    ENV{ID_USB_DRIVER}=="usb-storage", \
    ENV{ID_VENDOR_ID}=="05e3", \
    ENV{ID_MODEL_ID}=="0749", \
    ENV{ID_PATH}=="*usb-0:3*", \
    RUN+="/bin/sh -c 'echo \"[$(date -Iseconds)] [udev] SD remove: /dev/%k\" >> /var/log/photonforge.log && /opt/photonforge/scripts/safe_eject.sh /mnt/photon_sd >> /var/log/photonforge.log 2>&1'"
