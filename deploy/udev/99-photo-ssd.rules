# PHOTONForge: Trigger pipeline when the PHOTON SSD is inserted.
# Hardware: Yoga 920 front-left USB-C (usb-0:1), UAS driver, VID 152d.
# Port-path match excludes rear USB 2.0 port.
# ID_FS_LABEL is NOT used — the SSD is labeled "rpool", not "PHOTON*".
# Install to /etc/udev/rules.d/ via scripts/install_udev.sh

ACTION=="add", SUBSYSTEM=="block", DEVTYPE=="partition", \
    ENV{ID_USB_DRIVER}=="uas", \
    ENV{ID_VENDOR_ID}=="152d", \
    ENV{ID_PATH}=="*usb-0:1*", \
    RUN+="/bin/sh -c 'echo \"[$(date -Iseconds)] [udev] SSD add: /dev/%k\" >> /var/log/photonforge.log && mkdir -p /mnt/photon_ssd && mount /dev/%k /mnt/photon_ssd && /opt/photonforge/scripts/manage_ssd.sh /dev/%k /mnt/photon_ssd >> /var/log/photonforge.log 2>&1'"

ACTION=="remove", SUBSYSTEM=="block", DEVTYPE=="partition", \
    ENV{ID_USB_DRIVER}=="uas", \
    ENV{ID_VENDOR_ID}=="152d", \
    ENV{ID_PATH}=="*usb-0:1*", \
    RUN+="/bin/sh -c 'echo \"[$(date -Iseconds)] [udev] SSD remove: /dev/%k\" >> /var/log/photonforge.log && /opt/photonforge/scripts/safe_eject.sh /mnt/photon_ssd >> /var/log/photonforge.log 2>&1'"
