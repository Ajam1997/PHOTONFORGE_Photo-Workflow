FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
        darktable \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /home/ubuntu/.config/darktable \
    && chown -R ubuntu:ubuntu /home/ubuntu

USER ubuntu

CMD ["darktable"]
